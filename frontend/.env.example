# Demo-only client-side radius override. Production must enforce radius on backend.
# Set to "true" to allow check-in outside the allowed radius during demo/simulation.
VITE_DEMO_RADIUS_OVERRIDE=false
VITE_API_PROXY_TARGET=http://localhost:8099
# Backend API base URL used directly when the frontend is NOT served through the Vite dev proxy.
# Leave empty to use the same origin (or the Vite proxy) in development.
VITE_API_BASE_URL=
