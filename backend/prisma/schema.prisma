datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMINISTRATOR
  SALES_MANAGER
  SALES_EXECUTIVE
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ProspectStatus {
  NEW_LEAD
  CONTACTED
  INTERESTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
  CONVERTED
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  email           String           @unique
  passwordHash    String           @map("password_hash")
  fullName        String           @map("full_name")
  employeeId      String?          @unique @map("employee_id")
  phone           String?          @default("")
  timezone        String?          @default("Asia/Jakarta")
  city            String?
  province        String?
  district        String?
  jobTitle        String?          @map("job_title")
  positionGrade   String?          @map("position_grade")
  subDepartment   String?          @map("sub_department")
  joinDate        DateTime?        @map("join_date") @db.Date
  gender          String?
  dateOfBirth     DateTime?        @map("date_of_birth") @db.Date
  avatarPath      String?          @map("avatar_path")
  role            UserRole
  status          UserStatus       @default(ACTIVE)
  tokenVersion    Int              @default(1) @map("token_version")
  lastLoginAt     DateTime?        @map("last_login_at") @db.Timestamptz(6)
  mustChangePassword Boolean       @default(false) @map("must_change_password")
  managerId       String?          @map("manager_id") @db.Uuid
  salesRoleId     String?          @map("sales_role_id") @db.Uuid
  manager         User?            @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  salesRole       SalesRole?       @relation("UserSalesRole", fields: [salesRoleId], references: [id], onDelete: SetNull)
  subordinates    User[]           @relation("UserManager")
  createdBy       String?          @map("created_by") @db.Uuid
  createdByUser   User?            @relation("UserCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAccounts User[]           @relation("UserCreatedBy")
  updatedBy       String?          @map("updated_by") @db.Uuid
  updatedByUser   User?            @relation("UserUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  updatedAccounts User[]           @relation("UserUpdatedBy")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz(6)
  refreshSessions RefreshSession[]
  assignedProspects Prospect[]              @relation("ProspectSalesExecutive")
  prospectStatusChanges ProspectStatusHistory[] @relation("ProspectStatusActor")
  assignedCustomerSites CustomerSite[]      @relation("CustomerSalesExecutive")
  convertedCustomerSites CustomerSite[]     @relation("CustomerConverter")
  prospectVisits ProspectVisit[]             @relation("ProspectVisitSalesExecutive")
  prospectComments ProspectComment[]        @relation("ProspectCommentUser")
  prospectAIChats  ProspectAIChat[]
  phoneNumbers    UserPhoneNumber[]
  providerUsageEvents ProviderUsageEvent[]
  activityLogs        ActivityLog[]

  @@index([salesRoleId])
  @@index([deletedAt])
  @@map("users")
}

model UserPhoneNumber {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  phoneNumber String   @map("phone_number")
  label       String?
  isPrimary   Boolean  @default(false) @map("is_primary")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_phone_numbers")
}

model ProviderUsageEvent {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  requestId         String?  @map("request_id") @db.VarChar(128)
  provider          String   @db.VarChar(32)
  feature           String   @db.VarChar(96)
  operation         String   @db.VarChar(96)
  apiOrModel        String   @map("api_or_model") @db.VarChar(160)
  skuCategory       String?  @map("sku_category") @db.VarChar(96)
  fieldMask         String?  @map("field_mask")
  inputTokens       Int?     @map("input_tokens")
  outputTokens      Int?     @map("output_tokens")
  totalTokens       Int?     @map("total_tokens")
  requestCount      Int      @default(1) @map("request_count")
  estimatedCostUsd  Decimal? @map("estimated_cost_usd") @db.Decimal(12, 8)
  httpStatus        Int?     @map("http_status")
  success           Boolean  @default(false)
  errorCode         String?  @map("error_code") @db.VarChar(96)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user              User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([provider, createdAt])
  @@index([feature, createdAt])
  @@map("provider_usage_events")
}

model ActivityLog {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String?  @map("user_id") @db.Uuid
  requestId       String   @map("request_id") @db.VarChar(128)
  method          String   @db.VarChar(12)
  endpoint        String
  requestBody     Json     @map("request_body")
  queryParams     Json     @map("query_params")
  responseBody    Json     @map("response_body")
  responseStatus  Int      @map("response_status")
  domain          String   @db.VarChar(32)
  additionalTrace Json     @map("additional_trace")
  durationMs      Int?     @map("duration_ms")
  ip              String?  @db.VarChar(64)
  userAgent       String?  @map("user_agent")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([requestId])
  @@index([domain, createdAt])
  @@map("activity_logs")
}

model RefreshSession {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  tokenHash           String    @map("token_hash")
  userAgent           String    @default("") @map("user_agent")
  ipAddress           String    @default("") @map("ip_address")
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason        String?   @map("revoke_reason")
  replacedBySessionId String?   @map("replaced_by_session_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model Prospect {
  id                       String                  @id @default(uuid()) @db.Uuid
  googlePlaceId            String                  @unique @map("google_place_id")
  placeName                String                  @map("place_name")
  formattedAddress         String                  @map("formatted_address")
  latitude                 Float?                  @db.DoublePrecision
  longitude                Float?                  @db.DoublePrecision
  placeCategory            String                  @map("place_category")
  industryGroup            String                  @default("Other") @map("industry_group")
  placeTypes               Json                    @default("[]") @map("place_types")
  phoneNumber              String?                 @map("phone_number")
  websiteUrl               String?                 @map("website_url")
  googleMapsUrl            String?                 @map("google_maps_url")
  assignedSalesExecutiveId String                  @map("assigned_sales_executive_id") @db.Uuid
  visitNotes               String                  @default("") @map("visit_notes")
  followUpNotes            String                  @default("") @map("follow_up_notes")
  status                   ProspectStatus          @default(NEW_LEAD)
  deletionRequested        Boolean                 @default(false) @map("deletion_requested")
  convertedAt              DateTime?               @map("converted_at") @db.Timestamptz(6)
  createdAt                DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  assignedSalesExecutive   User                    @relation("ProspectSalesExecutive", fields: [assignedSalesExecutiveId], references: [id], onDelete: Restrict)
  statusHistory            ProspectStatusHistory[]
  convertedCustomerSite    CustomerSite?
  visits                   ProspectVisit[]
  comments                 ProspectComment[]        @relation("ProspectCommentProspect")
  photoTags                ProspectPhotoTag[]      @relation("ProspectPhotoTagProspect")
  aiAnalysis              ProspectAIAnalysis?
  aiChats                 ProspectAIChat[]

  @@index([assignedSalesExecutiveId, status])
  @@index([status, createdAt])
  @@map("prospects")
}

model ProspectAIAnalysis {
  prospectId String   @id @map("prospect_id") @db.Uuid
  summaryJson Json?   @map("summary_json")
  menuJson    Json?   @map("menu_json")
  status      String   @default("PENDING")
  errorCode   String   @default("") @map("error_code")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  prospect    Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  @@map("prospect_ai_analyses")
}

model ProspectAIChat {
  id                String   @id @default(uuid()) @db.Uuid
  prospectId        String   @map("prospect_id") @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  message           String
  answer            String
  skill             String
  insight           String?
  why               String?
  recommendedAction String?  @map("recommended_action")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  prospect          Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([prospectId, createdAt])
  @@index([userId, createdAt])
  @@map("prospect_ai_chats")
}

model ProspectVisit {
  id                       String    @id @default(uuid()) @db.Uuid
  prospectId               String    @map("prospect_id") @db.Uuid
  salesExecutiveId         String    @map("sales_executive_id") @db.Uuid
  checkInAt                DateTime  @map("check_in_at") @db.Timestamptz(6)
  checkInLatitude          Float     @map("check_in_latitude") @db.DoublePrecision
  checkInLongitude         Float     @map("check_in_longitude") @db.DoublePrecision
  checkOutAt               DateTime? @map("check_out_at") @db.Timestamptz(6)
  checkOutLatitude         Float?    @map("check_out_latitude") @db.DoublePrecision
  checkOutLongitude        Float?    @map("check_out_longitude") @db.DoublePrecision
  selfieReference          String    @default("") @map("selfie_reference")
  visitNotes               String    @default("") @map("visit_notes")
  followUpNotes            String    @default("") @map("follow_up_notes")
  visitResult              String    @default("") @map("visit_result")
  visitOutcome             String    @default("") @map("visit_outcome")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  prospect                 Prospect  @relation(fields: [prospectId], references: [id], onDelete: Restrict)
  salesExecutive           User      @relation("ProspectVisitSalesExecutive", fields: [salesExecutiveId], references: [id], onDelete: Restrict)

  @@index([prospectId, checkInAt])
  @@index([salesExecutiveId, checkInAt])
  @@map("prospect_visits")
}

model ProspectStatusHistory {
  id              String         @id @default(uuid()) @db.Uuid
  prospectId      String         @map("prospect_id") @db.Uuid
  fromStatus      ProspectStatus? @map("from_status")
  toStatus        ProspectStatus  @map("to_status")
  changedByUserId String         @map("changed_by_user_id") @db.Uuid
  notes           String         @default("")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  prospect        Prospect       @relation(fields: [prospectId], references: [id], onDelete: Restrict)
  changedBy       User           @relation("ProspectStatusActor", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([prospectId, createdAt])
  @@map("prospect_status_history")
}

model ParentCompany {
  id                  String         @id @default(uuid()) @db.Uuid
  parentCode          String         @unique @map("parent_code")
  name                String
  addressMode         String         @default("MANUAL") @map("address_mode")
  province            String         @default("")
  district            String         @default("")
  subDistrict         String         @default("") @map("sub_district")
  village             String         @default("")
  latitude            Float?         @db.DoublePrecision
  longitude           Float?         @db.DoublePrecision
  previewAddress      String         @default("") @map("preview_address")
  companyContacts     Json           @default("[]") @map("company_contacts")
  npwpName            String         @default("") @map("npwp_name")
  npwpAddress         String         @default("") @map("npwp_address")
  npwpNumber          String         @default("") @map("npwp_number")
  termOfPayment       String         @default("") @map("term_of_payment")
  kamAssignments      Json           @default("[]") @map("kam_assignments")
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  customerSites       CustomerSite[]

  @@index([name])
  @@map("parent_companies")
}

model CustomerSite {
  id                       String        @id @default(uuid()) @db.Uuid
  customerCode             String        @unique @map("customer_code")
  parentCompanyId          String        @map("parent_company_id") @db.Uuid
  sourceProspectId         String        @unique @map("source_prospect_id") @db.Uuid
  sourceGooglePlaceId      String        @unique @map("source_google_place_id")
  name                     String
  segment                  String
  category                 String
  addressMode              String        @default("MANUAL") @map("address_mode")
  province                 String        @default("")
  district                 String        @default("")
  subDistrict              String        @default("") @map("sub_district")
  village                  String        @default("")
  latitude                 Float?        @db.DoublePrecision
  longitude                Float?        @db.DoublePrecision
  previewAddress           String        @map("preview_address")
  siteContacts             Json          @default("[]") @map("site_contacts")
  ppn                      String        @default("")
  idTkuNumber              String        @default("") @map("id_tku_number")
  nik                      String        @default("")
  shipmentCost             String        @default("") @map("shipment_cost")
  invoiceType              String        @default("") @map("invoice_type")
  bankAccount              String        @default("") @map("bank_account")
  billToSource             String        @default("") @map("bill_to_source")
  shipToSource             String        @default("") @map("ship_to_source")
  billingAddressPreview    String        @default("") @map("billing_address_preview")
  shippingAddressPreview   String        @default("") @map("shipping_address_preview")
  salesExecutiveId         String        @map("sales_executive_id") @db.Uuid
  salesAssignments         Json          @default("[]") @map("sales_assignments")
  convertedAt              DateTime      @map("converted_at") @db.Timestamptz(6)
  convertedByAdminId       String        @map("converted_by_admin_id") @db.Uuid
  createdAt                DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  parentCompany            ParentCompany @relation(fields: [parentCompanyId], references: [id], onDelete: Restrict)
  sourceProspect           Prospect      @relation(fields: [sourceProspectId], references: [id], onDelete: Restrict)
  salesExecutive           User          @relation("CustomerSalesExecutive", fields: [salesExecutiveId], references: [id], onDelete: Restrict)
  convertedByAdmin         User          @relation("CustomerConverter", fields: [convertedByAdminId], references: [id], onDelete: Restrict)

  @@index([salesExecutiveId, convertedAt])
  @@index([parentCompanyId])
  @@map("customer_sites")
}

model ProspectComment {
  id         String   @id @default(uuid()) @db.Uuid
  prospectId String   @map("prospect_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
    content    String
    attachments Json     @default("[]")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  prospect   Prospect @relation("ProspectCommentProspect", fields: [prospectId], references: [id], onDelete: Cascade)
  user       User     @relation("ProspectCommentUser", fields: [userId], references: [id], onDelete: Restrict)

  @@index([prospectId, createdAt])
  @@index([userId])
  @@map("prospect_comments")
}

model ProspectPhotoTag {
  id         String   @id @default(uuid()) @db.Uuid
  prospectId String   @map("prospect_id") @db.Uuid
    photoName  String   @map("photo_name")
    photoIndex Int?     @map("photo_index")
  category   String   @map("category")
  updatedBy  String?  @map("updated_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  prospect   Prospect @relation("ProspectPhotoTagProspect", fields: [prospectId], references: [id], onDelete: Cascade)

  @@unique([prospectId, photoName])
  @@index([prospectId])
  @@map("prospect_photo_tags")
}

model SalesRole {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(255)
  normalizedName String @map("normalized_name") @db.VarChar(255)
  level       Int      @db.SmallInt
  description String?
  isActive   Boolean  @default(true) @map("is_active")
  landingPage String?  @map("landing_page")
  createdBy  String?  @map("created_by") @db.Uuid
  updatedBy  String?  @map("updated_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  accountUsers User[] @relation("UserSalesRole")
  assignments SalesStructureAssignment[]
  rolePermissions RolePermission[]

  @@index([level])
  @@map("sales_roles")
}

model SalesStructureAssignment {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  salesRoleId   String    @map("sales_role_id") @db.Uuid
  parentUserId  String?   @map("parent_user_id") @db.Uuid
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  createdBy     String?   @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  salesRole     SalesRole @relation(fields: [salesRoleId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([parentUserId])
  @@index([salesRoleId])
  @@index([effectiveFrom])
  @@index([effectiveTo])
  @@map("sales_structure_assignments")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(255)
  name        String   @db.VarChar(255)
  description String?
  groupKey    String   @map("group_key") @db.VarChar(255)
  parentKey   String?  @map("parent_key") @db.VarChar(255)
  nodeType    String   @map("node_type") @db.VarChar(32)
  routePath   String?  @map("route_path") @db.VarChar(255)
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  rolePermissions RolePermission[]

  @@index([groupKey, sortOrder])
  @@index([parentKey])
  @@map("permissions")
}

model RolePermission {
  salesRoleId  String     @map("sales_role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  salesRole    SalesRole  @relation(fields: [salesRoleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([salesRoleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}
