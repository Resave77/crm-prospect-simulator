APP_ENV=development
PORT=8099
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yummy_crm?sslmode=disable
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=yummy-crm
JWT_AUDIENCE=yummy-crm-api
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
ALLOWED_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
GOOGLE_MAPS_API_KEY=
GOOGLE_CSE_ID=
GOOGLE_CSE_API_KEY=
GOOGLE_PLACES_SEARCH_CACHE_TTL=12h
GOOGLE_PLACES_CORE_DETAIL_CACHE_TTL=12h
GOOGLE_PLACES_BUSINESS_INFO_CACHE_TTL=12h
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT=20s
OPENAI_FIND_MENU_TIMEOUT=60s
OPENAI_MENU_PROFILE_TIMEOUT=40s
OPENAI_CACHE_TTL=15m
OPENAI_MAX_OUTPUT_TOKENS=800
AI_CHAT_MAX_MESSAGE_LENGTH=1000
AI_CHAT_MAX_HISTORY_MESSAGES=6
